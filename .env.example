# ==============================================================================
# developer-infra — Environment Configuration Template (v2.1)
# Copy to .env and replace all CHANGE_ME values before starting:
#   cp .env.example .env
# ==============================================================================

# --- Multi-Instance / Multi-User Identity (D2) ---
# Set a unique COMPOSE_PROJECT_NAME and non-overlapping ports per instance/user.
COMPOSE_PROJECT_NAME=devbox-main
WORKSPACE_DIR=./workspace

# --- Network Binding & Ports (D2) ---
# Keep 127.0.0.1 for local workstation or SSH-tunneled remote servers.
# Never expose 0.0.0.0 without TLS reverse proxy + external firewall.
# Tip: On Windows, if 8080 hits WinNAT excludedportrange, run `.\run-env.ps1 -AutoPort`
# or set CODE_SERVER_PORT=18080.
BIND_HOST=127.0.0.1
CODE_SERVER_PORT=8080
NOVNC_PORT=6901
OMNIROUTE_PORT=20128

# --- Mandatory UI Authentication (D9) ---
# Preflight blocks startup if empty or left as CHANGE_ME.
CODE_SERVER_PASSWORD=CHANGE_ME_STRONG_CODE_PASSWORD
VNC_PASSWORD=CHANGE_ME_STRONG_VNC_PASSWORD

# --- Resource Limits (D2) ---
# Workstation preset (1 developer, 16-32 GB host RAM):
#   CPUS=6  | MEM_LIMIT=10g | SHM_SIZE=2g
# Shared multi-user server preset (4+ containers on 32 GB RAM):
#   CPUS=2  | MEM_LIMIT=4g  | SHM_SIZE=1g
CPUS=6
MEM_LIMIT=10g
SHM_SIZE=2g

# --- VPN Subscription & Updater (D5, v2.1) ---
# Dynamic subscription URL (e.g., https://auth.quattro-cloud.ru/...).
# Leave empty to use static ./sing-box/config.json fallback only.
VPN_SUBSCRIPTION_URL=
# Refresh interval on success (seconds, default 3600 = 60m) and retry on failure (600 = 10m)
VPN_UPDATE_INTERVAL=3600
VPN_RETRY_INTERVAL=600
# TUN MTU: 1280 is safe both standalone AND inside a host TUN VPN (avoids MTU blackhole).
# Raise to 1400 only if you never run a host TUN VPN simultaneously.
VPN_MTU=1280
# Parallel TCP reachability pre-probe (SO_MARK=255) before writing sing-box config (1/0).
# Automatically filters out dead or geo-blocked nodes from 500+ node subscriptions.
VPN_PROBE_NODES=1
# Security default: 0 blocks nodes with insecure=1 / allowInsecure=1 / pinned self-signed pcs
# (logs skipped_insecure count). Set to 1 ONLY if you explicitly trust self-signed nodes.
VPN_ALLOW_INSECURE=0
# Cap active nodes in urltest to avoid probe storms on 500+ node subscriptions
VPN_MAX_NODES=30
# Preferred protocol priority order (comma-separated: vless,hysteria2)
VPN_PROTOCOL_ORDER=vless,hysteria2
# Optional regex filters matched against node display name / tag (case-insensitive)
VPN_NODE_FILTER=
VPN_NODE_EXCLUDE=(?i)(expired|traffic|info|website|support)

# --- VPN Kill-Switch & Watchdog (D6) ---
# strict   = TUN + block all non-VPN traffic (IPv4 + IPv6 + Docker DNS) when sing-box is down (default)
# fallback = TUN + allow direct egress automatically if VPN fails (shows warning banner)
# proxy    = no TUN/kill-switch; local mixed proxy on 127.0.0.1:2080 inside container only
# direct   = VPN stopped and bypassed explicitly (managed via vpn-ctl)
VPN_FAIL_MODE=strict
# Enable desktop notifications via notify-send/dunst when kill-switch trips (1/0)
VPN_GUI_NOTIFICATIONS=1

# --- GUI / Display (D1) ---
# Startup URL for Chromium: local VPN Status Dashboard (works instantly even under kill-switch)
CHROMIUM_START_URL=http://127.0.0.1:9099
# Set to 1 on low-end GPUs if Chromium spikes CPU under WSLg
CHROMIUM_DISABLE_GPU=0

# --- AI Stack (D3, D7) ---
# Optional: pass OmniRoute API token into container for non-interactive start-claude runs
ANTHROPIC_AUTH_TOKEN=